# Override how the sandbox reaches the network. Copy to ~/.config/kali-sandbox.env
#   NET_MODE=iface
#   TUNNEL_IFACE=wg0          # pin egress to this interface (or a host IP)
#   NET_MODE=vpn
#   VPN_CONFIG=/work/vpn/wg0.conf
# Leave TUNNEL_IFACE unset to auto-detect the default-route interface.
NET_MODE=iface
