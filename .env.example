# Copy to .env and adjust for your host.  cp .env.example .env
# ---- GPU (ROCm) ----
# GID of the 'render' group:  getent group render | cut -d: -f3
RENDER_GID=987
# GID of the 'video' group:   getent group video | cut -d: -f3
VIDEO_GID=983
# Which GPU llama.cpp/ComfyUI use (rocm-smi to list)
HIP_VISIBLE_DEVICES=0
# ---- rootless podman socket (kali-mcp bridge execs into kali-sandbox) ----
# Usually /run/user/<uid>/podman/podman.sock  (echo $XDG_RUNTIME_DIR)
XDG_RUNTIME_DIR=/run/user/1000
# ---- model trees (NOT in this repo; point at where you downloaded them) ----
# GGUF models served by llama-swap:
MODELS_DIR=/srv/models
# ComfyUI checkpoints/VAE/etc. (see services/comfyui/download-models.sh):
COMFYUI_MODELS_DIR=/srv/comfyui/models
# Where generated images are written:
COMFYUI_OUTPUT_DIR=/srv/comfyui/output
